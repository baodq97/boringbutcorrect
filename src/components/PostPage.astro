---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Route from './Route.astro';
import Video from './Video.astro';
import { postUrl, readingMinutes, type Numbered, type Post } from '../lib/posts';
import { stations, pad, isoDate } from '../lib/stations';
import { organization } from '../lib/site';
import { ui, root, home, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  post: Post;
  no: string;
  prev?: Numbered;
  next?: Numbered;
  related: Post[];
  translation?: Post;
}
const { lang, post, prev, next, related, translation } = Astro.props;
const t = ui[lang];
const { Content, headings } = await render(post);
const d = post.data;
const station = stations.find((s) => s.n === d.station)!;
const minutes = readingMinutes(post.body);
const toc = headings.filter((h) => h.depth === 2 && h.slug !== 'footnote-label');
const url = new URL(postUrl(post), Astro.site).href;
const image = d.image ?? (d.video && `https://i.ytimg.com/vi/${d.video.id}/maxresdefault.jpg`);
const modified = d.verified > d.published ? d.verified : d.published;
const channel = organization(Astro.site);
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.seoTitle ?? d.title,
    description: d.description,
    inLanguage: t.htmlLang,
    datePublished: isoDate(d.published),
    dateModified: isoDate(modified),
    ...(image && { image: new URL(image, Astro.site).href }),
    mainEntityOfPage: url,
    author: channel,
    publisher: channel,
    ...(lang === 'en' && translation && { translationOfWork: { '@id': new URL(postUrl(translation), Astro.site).href } }),
  },
];
const stationHref = `${root(lang)}/#tram-${pad(station.n)}`;
jsonLd.push({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Boring But Correct', item: new URL(home(lang), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: station.name, item: new URL(stationHref, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title, item: url },
  ],
});
if (d.video) {
  const [min, sec] = d.video.duration.split(':').map(Number);
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: d.title,
    description: d.description,
    thumbnailUrl: new URL(image!, Astro.site).href,
    uploadDate: d.published.toISOString(),
    duration: `PT${min}M${sec}S`,
    contentUrl: `https://www.youtube.com/watch?v=${d.video.id}`,
    embedUrl: `https://www.youtube.com/embed/${d.video.id}`,
  });
}
const leg = (n?: Numbered) => n && { href: postUrl(n.post), no: n.no, title: n.post.data.title, date: n.post.data.published };
const legs = [
  { label: t.legs.prev, trip: leg(prev), none: t.legs.first },
  { label: t.legs.next, trip: leg(next), none: t.legs.last },
];
---
<Base title={d.seoTitle ?? `${d.title} | Boring But Correct`} description={d.description} type="article" image={image} article={{ published: isoDate(d.published), modified: isoDate(modified), section: station.name }} markdownHref={`${postUrl(post)}.md`} jsonLd={jsonLd} lang={lang} translation={translation && postUrl(translation)}>
  <Route current={d.station} compact lang={lang} />
  <article class="article">
    <h1>{d.title}</h1>
    <p class="dek">{d.description}</p>
    <dl class="meta">
      <div><dt>{t.meta.station}</dt><dd><a href={stationHref}><span class="no">{pad(station.n)}</span> {station.name}</a></dd></div>
      <div><dt>{t.meta.published}</dt><dd><time datetime={isoDate(d.published)}>{t.date(d.published)}</time></dd></div>
      <div><dt>{t.meta.verified}</dt><dd><time datetime={isoDate(d.verified)}>{t.date(d.verified)}</time></dd></div>
      <div><dt>{t.meta.read}</dt><dd><span class="no">{minutes}</span> {t.minutes}</dd></div>
      {d.video && <div><dt>{t.meta.video}</dt><dd><a href="#video"><span class="no">{d.video.duration}</span></a></dd></div>}
      <div><dt>{t.meta.agent}</dt><dd><a href={`${postUrl(post)}.md`} type="text/markdown">Markdown</a></dd></div>
    </dl>
    {toc.length >= 3 && (
      <nav class="toc" aria-labelledby="trong-bai">
        <h2 id="trong-bai">{t.toc}</h2>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}
    {d.video && <Video id={d.video.id} title={d.title} duration={d.video.duration} image={d.image} lang={lang} />}
    <div class="prose">
      <Content />
      {d.sources.length > 0 && (
        <section class="refs" aria-labelledby="tai-lieu">
          <h2 id="tai-lieu">{t.refs}</h2>
          <ul>{d.sources.map((s) => <li><a href={s.url}>{s.title}</a></li>)}</ul>
        </section>
      )}
    </div>
  </article>
  {related.length > 0 && (
    <section class="related" aria-labelledby="cung-tram">
      <h2 id="cung-tram">{t.sameStation} {station.name}</h2>
      <ul>{related.map((p) => <li><a href={postUrl(p)}>{p.data.title}</a> <time class="no" datetime={isoDate(p.data.published)}>{t.date(p.data.published)}</time></li>)}</ul>
    </section>
  )}
  <nav class="legs" aria-label={t.legs.nav}>
    {legs.map(({ label, trip, none }) => (
      <div class="leg">
        <span class="leg-label">{label}</span>
        {trip
          ? <a href={trip.href}><span class="no">{trip.no}</span> {trip.title}</a>
          : <span class="leg-none">{none}</span>}
        {trip && <time class="no" datetime={isoDate(trip.date)}>{t.date(trip.date)}</time>}
      </div>
    ))}
    <div class="leg"><span class="leg-label">{t.legs.all}</span><a href={stationHref}>{t.legs.allPosts}</a></div>
  </nav>
</Base>

<style>
  .meta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    margin: 0 0 2.5rem;
    border-top: var(--rule);
    border-bottom: 1px solid var(--ink);
  }
  .meta div { padding: 0.6rem 2rem 0.7rem 0; }
  .meta div + div { padding-left: 1rem; border-left: 1px solid var(--hair); }
  dt { font-size: var(--s-12); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  dd { margin: 0.15rem 0 0; font-size: var(--s-16); font-weight: 600; }
  dd a { text-decoration-color: var(--hair); }
  .toc { grid-column: 1 / 8; margin: 0 0 3rem; }
  .toc h2 { font-size: var(--s-12); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin: 0 0 0.5rem; }
  .toc ol { margin: 0; padding: 0; list-style: none; }
  .toc li { padding: 0.45rem 0; border-bottom: 1px solid var(--hair); font-size: var(--s-16); }
  .toc a { text-decoration: none; font-weight: 600; }
  .toc a:hover { text-decoration: underline; }
  .article :global(.video) { grid-column: 1 / 8; }
  .related { margin-top: 5rem; border-top: var(--rule); padding-top: 0.75rem; }
  .related h2 { font-size: var(--s-22); font-weight: 800; margin: 0 0 0.5rem; }
  .related ul { list-style: none; margin: 0; padding: 0; }
  .related li { display: flex; justify-content: space-between; gap: var(--gap); padding: 0.6rem 0; border-bottom: 1px solid var(--hair); }
  .related a { font-weight: 700; text-decoration: none; }
  .related a:hover { text-decoration: underline; }
  .related time { color: var(--muted); font-size: var(--s-14); }
  .legs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap);
    margin-top: 5rem;
    border-top: var(--rule);
    padding-top: 0.75rem;
  }
  .leg { display: grid; gap: 0.25rem; align-content: start; }
  .leg-label { font-size: var(--s-12); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .leg a { font-weight: 700; text-decoration: none; line-height: 1.4; }
  .leg a:hover { text-decoration: underline; }
  .leg time { font-size: var(--s-14); color: var(--muted); }
  .leg-none { color: var(--muted); }

  @media (max-width: 1100px) {
    .toc { grid-column: 1 / -1; max-width: 42rem; }
    .article :global(.video) { grid-column: 1 / -1; max-width: 42rem; }
  }
  @media (max-width: 720px) {
    .meta { display: grid; grid-template-columns: 1fr 1fr; }
    .meta div { padding-right: 1rem; }
    .meta div + div { padding-left: 0; border-left: 0; }
    .legs { grid-template-columns: 1fr; gap: 1.25rem; }
    .related li { flex-direction: column; gap: 0.15rem; }
  }
</style>
