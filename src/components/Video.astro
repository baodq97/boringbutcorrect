---
interface Props {
  id: string;
  title: string;
  duration: string;
  image?: string;
}
const { id, title, duration, image = `https://i.ytimg.com/vi/${id}/maxresdefault.jpg` } = Astro.props;
---
<figure class="video" id="video">
  <a class="video-link" href={`https://www.youtube.com/watch?v=${id}`} data-video={id}>
    <img src={image} alt="" width="1280" height="720" decoding="async" />
    <span class="play"><span class="play-icon" aria-hidden="true"></span>Xem video đi kèm <span class="no">{duration}</span></span>
    <span class="sr-only">: {title}</span>
  </a>
</figure>
<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-video]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${link.dataset.video}?autoplay=1`;
      frame.title = link.textContent?.trim() ?? 'Video';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      link.replaceWith(frame);
      frame.focus();
    });
  });
</script>
