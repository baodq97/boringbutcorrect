---
import '../styles/global.css';
import { social, rssIcon, verifyIcon } from '../lib/site';
import { ui, home, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  image?: string;
  article?: { published: string; modified: string; section: string };
  markdownHref?: string;
  jsonLd?: object[];
  lang?: Lang;
  translation?: string;
}
const { title, description, type = 'website', image, article, markdownHref, jsonLd = [], lang = 'vi', translation } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'vi' ? 'en' : 'vi';
const follow = [
  { name: t.verifyPage.name, url: t.verifyPage.url, icon: verifyIcon },
  ...social,
  { name: 'RSS', url: t.rss, icon: rssIcon },
];
const versions = translation ? { [lang]: canonicalOf(Astro.url.pathname), [other]: new URL(translation, Astro.site) } : undefined;
function canonicalOf(path: string) {
  return new URL(path.replace(/(index)?\.html$/, ''), Astro.site);
}
const canonical = canonicalOf(Astro.url.pathname);
const ogImage = new URL(image ?? '/og/site.png', Astro.site);
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Boring But Correct" href={t.rss} />
    {versions && Object.entries(versions).map(([l, href]) => <link rel="alternate" hreflang={l} href={href} />)}
    {versions && <link rel="alternate" hreflang="x-default" href={versions.vi} />}
    <link rel="describedby" type="text/plain" href="/llms.txt" />
    <link rel="preload" href="/fonts/overpass.woff2" as="font" type="font/woff2" crossorigin />
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Boring But Correct" />
    <meta property="og:locale" content={t.ogLocale} />
    {versions && <meta property="og:locale:alternate" content={ui[other].ogLocale} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {article && <meta property="article:published_time" content={article.published} />}
    {article && <meta property="article:modified_time" content={article.modified} />}
    {article && <meta property="article:section" content={article.section} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#noi-dung">{t.skip}</a>
    <div class="wrap">
      <header class="masthead">
        <a class="wordmark" href={home(lang)}>Boring But Correct</a>
        <p class="tagline">{t.tagline}</p>
        <a class="lang-switch" href={translation ?? home(other)} hreflang={other} lang={other}>{t.otherLang}</a>
      </header>
      <main id="noi-dung"><slot /></main>
      <footer class="footer">
        <a class="footer-name" href={home(lang)}>Boring But Correct</a>
        <ul class="follow">
          {follow.map((s) => (
            <li>
              <a href={s.url} rel={s.url.startsWith('http') ? 'me' : undefined} aria-label={s.name} title={s.name}>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d={s.icon} /></svg>
              </a>
            </li>
          ))}
        </ul>
      </footer>
    </div>
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "d9dabecd9d6c4b79bda2bf8e31794fb8"}'></script>
  </body>
</html>
