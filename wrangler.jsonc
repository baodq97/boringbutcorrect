{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "boringbutcorrect",
  "compatibility_date": "2026-11-06",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/_astro/*", "!/fonts/*", "!/og/*", "!/*.md", "!/*.txt", "!/*.xml", "!/*.ico", "!/*.png", "!/*.svg"]
  },
  "routes": [{ "pattern": "boringbutcorrect.com", "custom_domain": true }]
}
